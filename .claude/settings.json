{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/block-prisma-db-push.mjs",
            "statusMessage": "Checking for `prisma db push`..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/confirm-env-edit.mjs",
            "statusMessage": "Checking for .env file edits..."
          }
        ]
      }
    ]
  }
}
